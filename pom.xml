<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>gov.fdic.tip</groupId>
    <artifactId>tip-commons-notification</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>tip-commons-notification</name>
    <description>
        Shared library so any TIP service can publish a notification event
        with one call, without knowing about the notification service's REST
        contract, Entra auth flow, or idempotency key mechanics. Mirrors the
        pure-Java-core / Spring-wrapper / static-util / auto-configuration
        layering already used elsewhere in tip-commons (see RetentionEngine /
        RetentionService / RetentionUtil / TipCommonsAutoConfiguration).

        IMPORTANT: this calls the notification service's REST endpoint
        (POST /api/v1/notification-events), NOT Azure Event Hub directly.
        Event Hub publishing only happens server-side, AFTER
        NotificationPublishService persists the NotificationEvent and its
        NotificationDelivery rows - publishing to Event Hub from this jar
        directly would bypass that entirely and produce Event Hub messages
        with no corresponding database rows for the consumer to act on.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <azure-identity.version>1.13.0</azure-identity.version>
        <spring-boot.version>3.2.5</spring-boot.version>
        <jackson.version>2.17.0</jackson.version>
    </properties>

    <dependencies>
        <!-- Used only to acquire a bearer token as THIS service's own Entra
             service principal, to call the notification service's protected
             REST endpoint. Not used for Event Hub - see class javadocs. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>${azure-identity.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Spring is OPTIONAL, matching tip-commons' existing pattern - the
             core engine has no hard Spring dependency and is usable from
             plain Java (e.g. a non-Spring batch utility), while Spring Boot
             consumers get auto-configuration for free. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.32</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test-autoconfigure</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.25.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
